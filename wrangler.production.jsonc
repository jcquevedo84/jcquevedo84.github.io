{
  "name": "digital-twin-production",
  "main": "worker/production.mjs",
  "keep_vars": true,
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "ai": { "binding": "AI" },
  "vars": {
    "DIGITAL_TWIN_INFERENCE_ENABLED": "false",
    "DIGITAL_TWIN_ALLOWED_ORIGINS": "https://jcquevedo84.github.io",
    "TURNSTILE_EXPECTED_HOSTNAME": "jcquevedo84.github.io",
    "TURNSTILE_EXPECTED_ACTION": "digital_twin_chat",
    "DIGITAL_TWIN_DAILY_LIMIT": "30",
    "DIGITAL_TWIN_MINUTE_LIMIT": "10",
    "DIGITAL_TWIN_MAX_CONCURRENT": "2",
    "OPENROUTER_REQUIRE_PINNED_FREE_ROUTE": "true",
    "OPENROUTER_MODEL": "inclusionai/ling-3.2-flash:free",
    "OPENROUTER_ALLOWED_PROVIDERS": "antdigital/fp8"
  },
  "ratelimits": [
    { "name": "CHAT_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 8, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ADMISSION", "class_name": "InferenceAdmission" }]
  },
  "exports": {
    "InferenceAdmission": { "type": "durable-object", "storage": "sqlite" }
  }
}
