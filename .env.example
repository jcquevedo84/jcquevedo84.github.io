# Required backend-only OpenRouter configuration.
# Never prefix either variable with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Default paid model identifier. Requires available OpenRouter credits.
# Configure a :free variant only after confirming that variant is currently available.
OPENROUTER_MODEL=openai/gpt-oss-120b

# Optional OpenRouter transport and request limits.
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MAX_COMPLETION_TOKENS=1500
OPENROUTER_TIMEOUT_MS=25000
# Development-only sanitized HTTP diagnostics. Disabled by default.
OPENROUTER_DEBUG=false

# Standalone Digital Twin API.
DIGITAL_TWIN_HOST=127.0.0.1
DIGITAL_TWIN_PORT=8787
DIGITAL_TWIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DIGITAL_TWIN_SITE_URL=http://localhost:3000
DIGITAL_TWIN_RATE_LIMIT_REQUESTS=8
DIGITAL_TWIN_RATE_LIMIT_WINDOW_MS=600000
DIGITAL_TWIN_TRUST_PROXY=false

# Public, non-secret frontend configuration. Set this at build time for production.
# Local development automatically resolves port 8787 when this is unset.
NEXT_PUBLIC_DIGITAL_TWIN_API_BASE_URL=
