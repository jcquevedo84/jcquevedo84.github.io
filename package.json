{
  "name": "juan-carlos-rodriguez-portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "node node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 3000",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.mjs",
    "api": "node --env-file-if-exists=.env server/index.mjs",
    "build": "node node_modules/next/dist/bin/next build",
    "preview": "node scripts/serve-static.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/next/dist/bin/next typegen && node node_modules/typescript/bin/tsc --noEmit --incremental false",
    "test:api": "node scripts/test-api.mjs",
    "test:worker": "node --test worker/admission.test.mjs worker/index.test.mjs worker/staging.test.mjs worker/staging-fixture.test.mjs",
    "diagnose:openrouter": "node --env-file-if-exists=.env scripts/diagnose-openrouter.mjs",
    "verify:static": "node scripts/verify-static-output.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:api && npm run test:worker && npm run build && npm run verify:static"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "miniflare": "5.20261118.0-beta",
    "typescript": "5.9.3",
    "wrangler": "4.165.0"
  }
}
